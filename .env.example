# Copy to .env and fill in locally. Process environment takes precedence.
INFLUXDB_URL=https://your-influx-host:8086
INFLUXDB_ORG=your-organization
INFLUXDB_BUCKET=your-bucket
INFLUXDB_TOKEN=
POSTGRES_HOST=localhost
POSTGRES_USER=your-user
POSTGRES_PASSWORD=
POSTGRES_DB=your-database
# Solo para la API heredada (pkgs/api.py). Sin valor, la API rechaza las peticiones protegidas.
MSGAIT_API_KEY=
# Carpeta de exportación de la API; por defecto pkgs/data/exports
# MSGAIT_EXPORT_DIR=
